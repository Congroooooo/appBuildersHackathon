{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, on-device AI memory for unfinished work",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:e2e": "npm run build && node scripts/e2e-check.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:capture": "npm run build && node scripts/capture-check.mjs",
    "test:packaged": "node scripts/packaged-check.mjs",
    "test:restart": "npm run build && node scripts/restart-check.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
