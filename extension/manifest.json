{
  "manifest_version": 3,
  "name": "Continuum page context",
  "version": "0.1.0",
  "description": "Sends the title, headings, a short excerpt and highlighted text of pages you read to Continuum on this computer (native messaging, no network).",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
